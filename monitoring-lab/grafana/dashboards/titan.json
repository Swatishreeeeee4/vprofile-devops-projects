{
 "uid": "vprofile-titan",
 "title": "Titan app: metrics and logs",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests per second by endpoint",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (endpoint)(rate(http_requests_total[1m]))",
     "legendFormat": "{{endpoint}}",
     "datasource": {
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "p95 latency by endpoint",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le,endpoint)(rate(http_request_duration_seconds_bucket[2m])))",
     "legendFormat": "{{endpoint}}",
     "datasource": {
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "CPU usage %",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100",
     "legendFormat": "",
     "datasource": {
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Memory used %",
   "gridPos": {
    "x": 8,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
     "legendFormat": "",
     "datasource": {
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Targets up (1 = up)",
   "gridPos": {
    "x": 16,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up",
     "legendFormat": "{{job}}",
     "datasource": {
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Log lines per minute by level (Loki)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (level)(count_over_time({job=\"titan\"}[1m]))",
     "legendFormat": "{{level}}",
     "datasource": {
      "uid": "loki"
     }
    }
   ]
  },
  {
   "id": 7,
   "type": "logs",
   "title": "Error logs (Loki)",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{job=\"titan\", level=\"ERROR\"}",
     "datasource": {
      "uid": "loki"
     }
    }
   ]
  }
 ],
 "tags": [
  "vprofile"
 ]
}